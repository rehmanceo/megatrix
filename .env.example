# Public site URL — used for canonical tags, hreflang alternates, OG metadata, and sitemap.xml.
# Must be set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: forward submitted leads to any generic webhook (e.g. a GoHighLevel
# "Inbound Webhook" workflow trigger URL, Zapier, Make, etc.). Independent of
# the GHL_* vars below — set this OR those OR both. See src/app/api/lead/route.ts.
LEAD_WEBHOOK_URL=

# Optional: push submitted leads directly into GoHighLevel as a contact (with
# tags) plus a note carrying the extra form fields. Set BOTH to enable — see
# src/lib/ghl.ts. Get GHL_API_KEY from GHL: Settings -> Private Integrations ->
# Create New Integration -> scope "contacts.write" (and "contacts/notes.write"
# if it's listed separately). GHL_LOCATION_ID is the sub-account ID, visible in
# the location's Settings -> Business Info page, or in its URL.
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional: set either to load that platform's base tag (src/components/analytics/AdPixels.tsx).
# Until set, window.gtag / window.fbq stay undefined and every tracking call in
# src/lib/analytics.ts safely no-ops. NEXT_PUBLIC_GA4_ID looks like "G-XXXXXXXXXX"
# (GA4 admin -> Data Streams -> your stream). NEXT_PUBLIC_META_PIXEL_ID is the
# numeric Pixel ID (Meta Events Manager -> your pixel -> Settings).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
