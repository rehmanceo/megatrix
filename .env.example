# Public site URL — used for canonical tags, hreflang alternates, OG metadata, and sitemap.xml.
# Must be set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: forward submitted leads to any generic webhook (e.g. a GoHighLevel
# "Inbound Webhook" workflow trigger URL, Zapier, Make, etc.). Independent of
# the GHL_* vars below — set this OR those OR both. See src/app/api/lead/route.ts.
LEAD_WEBHOOK_URL=

# Optional: push submitted leads directly into GoHighLevel as a contact (with
# tags) plus a note carrying the extra form fields. Set BOTH to enable — see
# src/lib/ghl.ts. Get GHL_API_KEY from GHL: Settings -> Private Integrations ->
# Create New Integration -> scope "contacts.write" (and "contacts/notes.write"
# if it's listed separately). GHL_LOCATION_ID is the sub-account ID, visible in
# the location's Settings -> Business Info page, or in its URL.
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional: set any of these to load that platform's base tag
# (src/components/analytics/AdPixels.tsx). Until set, window.gtag / window.fbq
# stay undefined and every tracking call in src/lib/analytics.ts safely no-ops.
#
# NEXT_PUBLIC_GA4_ID looks like "G-XXXXXXXXXX" (GA4 admin -> Data Streams -> your stream).
# NEXT_PUBLIC_META_PIXEL_ID is the numeric Pixel ID (Meta Events Manager -> your pixel -> Settings).
# NEXT_PUBLIC_GTM_ID looks like "GTM-XXXXXXX" (Google Tag Manager -> your container, top right).
#   If you set this, manage GA4 as a tag inside the GTM container instead of
#   also setting NEXT_PUBLIC_GA4_ID — both loading GA4 at once double-counts.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Optional: Meta Conversions API (server-side) — complements the browser Meta
# Pixel above. Without this, only the client-side Pixel fires, which ad
# blockers, Safari ITP, and Firefox ETP routinely drop; the server-side copy
# below still reaches Meta even then, and is deduplicated against the Pixel
# event automatically (see src/lib/metaCapi.ts). Requires
# NEXT_PUBLIC_META_PIXEL_ID above to also be set.
#
# Generate META_CONVERSIONS_API_ACCESS_TOKEN in Meta Events Manager -> your
# pixel -> Settings -> Conversions API -> "Generate access token" (under
# "Set up manually"). Treat it like a password — it's server-only, never
# exposed to the browser, and never commit the real value.
#
# META_CAPI_TEST_EVENT_CODE is optional and only for testing: Events Manager
# -> your pixel -> Test Events gives you a code like "TEST12345" that makes
# events show up live in that tab without affecting real ad data. Remove it
# once you've confirmed events are arriving correctly.
META_CONVERSIONS_API_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
